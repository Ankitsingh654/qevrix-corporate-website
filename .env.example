# QEVRIX Frontend Environment Variables

# The base URL of the monolithic backend API service (development default: http://localhost:8082)
REACT_APP_API_BASE_URL=http://localhost:8082

# Neon Cloud PostgreSQL Connection String
DATABASE_URL=postgres://username:password@host/database?sslmode=require

# Node Mailer SMTP configurations (serverless API fallback)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-sender-email@gmail.com
MAIL_ADMIN_TO=receiver-admin-email@qevrix.in

